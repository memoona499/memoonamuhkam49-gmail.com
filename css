@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap');

:root {
    --mocha: #675448;
    --ink: #252a26;
    --blue: #dcecf0;
    --cream: #f2f0ea;
    --paper: #fbfaf7;
    --muted: #6f746d;
    --line: #e4e1d9;
}

* {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: 'DM Sans', sans-serif;
    line-height: 1.6;
}

a {
    color: inherit;
    text-decoration: none;
}

.site-header {
    min-height: 82px;
    padding: 0 6%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    border-bottom: 1px solid var(--line);
    background: var(--paper);
}

.brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: 'Manrope', sans-serif;
    font-size: 1.12rem;
    font-weight: 800;
}

.brand-mark {
    display: grid;
    place-items: center;
    width: 35px;
    height: 35px;
    border-radius: 12px;
    color: white;
    background: var(--mocha);
    font-size: 1.35rem;
}

.nav-links {
    display: flex;
    align-items: center;
    gap: 32px;
    font-size: .9rem;
    color: #51564f;
}

.nav-links a:hover {
    color: var(--mocha);
}

.nav-cta {
    padding: 11px 17px;
    border: 1px solid #c9c5bb;
    border-radius: 99px;
}

.menu-toggle {
    display: none;
    border: 0;
    background: transparent;
    font-size: 1.5rem;
    cursor: pointer;
}

.hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6vw;
    align-items: center;
    padding: 90px 8%;
    max-width: 1600px;
    margin: auto;
}

.eyebrow {
    font-size: .72rem;
    font-weight: 700;
    letter-spacing: .13em;
    color: var(--mocha);
}

.status-dot {
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-right: 8px;
    border-radius: 50%;
    background: #8a9c75;
}

h1, h2, h3 {
    font-family: 'Manrope', sans-serif;
    letter-spacing: -.055em;
    line-height: 1.12;
}

h1 {
    margin: 23px 0;
    font-size: clamp(3.25rem, 6vw, 5.5rem);
    font-weight: 600;
}

h1 em, h2 em {
    font-family: Georgia, serif;
    font-weight: 400;
    color: var(--mocha);
}

.hero-description {
    max-width: 490px;
    color: var(--muted);
    font-size: 1.02rem;
    line-height: 1.85;
}

.hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 24px;
    margin-top: 30px;
}

.button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    border-radius: 99px;
    padding: 14px 20px;
    font: inherit;
    font-size: .9rem;
    cursor: pointer;
    transition: transform .2s, background .2s;
}

.button:hover {
    transform: translateY(-2px);
}

.button-dark {
    color: white;
    background: var(--ink);
    border: 1px solid var(--ink);
}

.button-dark:hover {
    background: var(--mocha);
}

.text-link {
    font-size: .9rem;
    border-bottom: 1px solid #c6bdb1;
    padding-bottom: 3px;
}

.hero-note {
    display: flex;
    align-items: center;
    gap: 13px;
    margin-top: 46px;
    color: var(--muted);
    font-size: .78rem;
}

.avatar-stack {
    display: flex;
    padding-left: 4px;
}

.avatar-stack i {
    display: grid;
    place-items: center;
    margin-left: -4px;
    width: 27px;
    height: 27px;
    border: 2px solid var(--paper);
    border-radius: 50%;
    background: #d9bca6;
    color: #44372f;
    font-style: normal;
    font-size: .65rem;
}

.avatar-stack i:nth-child(2) {
    background: #cbd9cf;
}

.avatar-stack i:nth-child(3) {
    background: #d8d6e6;
}

/* Hero illustration */

.hero-art {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 430px;
    border-radius: 46% 46% 24px 24px;
    overflow: hidden;
    background: var(--blue);
}

.sun {
    position: absolute;
    width: 185px;
    height: 185px;
    right: 12%;
    top: 9%;
    border-radius: 50%;
    background: #f0d7ad;
}

.art-leaf {
    position: absolute;
    width: 150px;
    height: 270px;
    bottom: -35px;
    left: 3%;
    border: 2px solid #789083;
    border-radius: 100% 0 100% 0;
    transform: rotate(-24deg);
    opacity: .75;
}

.leaf-two {
    left: 13%;
    bottom: -70px;
    transform: rotate(15deg) scale(.75);
}

.art-card {
    z-index: 1;
    position: relative;
    width: 82%;
    max-width: 390px;
    padding: 25px;
    border-radius: 18px;
    background: rgba(255,255,255,.94);
    box-shadow: 0 25px 60px #384a4920;
    transform: rotate(-2deg);
}

.art-card-top,
.progress-label {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.art-card-top {
    color: #898d86;
    font-size: .62rem;
    letter-spacing: .09em;
    font-weight: 700;
}

.art-card h2 {
    margin: 21px 0 15px;
    font-size: 1.5rem;
}

.task-line {
    display: grid;
    grid-template-columns: 22px 1fr auto;
    align-items: center;
    gap: 8px;
    padding: 13px 0;
    border-bottom: 1px solid #eeece6;
    font-size: .76rem;
}

.task-line b {
    color: #8b8f87;
    font-size: .65rem;
    font-weight: 500;
}

.check, .empty-check {
    display: grid;
    place-items: center;
    width: 18px;
    height: 18px;
    border-radius: 6px;
    background: #dce7dc;
    color: #5e795f;
    font-size: .7rem;
}

.empty-check {
    border: 1px solid #d6d6ce;
    background: white;
}

.unfinished {
    color: #777c75;
}

.progress-label {
    margin-top: 22px;
    font-size: .72rem;
}

.progress-label strong {
    color: var(--mocha);
}

.progress-track {
    height: 6px;
    margin-top: 10px;
    border-radius: 99px;
    background: #ecebe5;
    overflow: hidden;
}

.progress-track span {
    display: block;
    width: 68%;
    height: 100%;
    border-radius: inherit;
    background: #8a9c75;
}

.floating-note {
    position: absolute;
    z-index: 2;
    right: 4%;
    bottom: 8%;
    display: flex;
    gap: 11px;
    align-items: center;
    padding: 13px 16px;
    background: white;
    border-radius: 14px;
    box-shadow: 0 12px 30px #384a491c;
}

.sparkle {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 10px;
    background: #f2e4d3;
    color: var(--mocha);
}

.floating-note strong,
.floating-note small {
    display: block;
}

.floating-note strong {
    font-size: .72rem;
}

.floating-note small {
    color: var(--muted);
    font-size: .62rem;
}

/* Three principles */

.metrics {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    padding: 27px 8%;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    max-width: 1360px;
    margin: 0 auto;
}

.metrics div {
    display: flex;
    align-items: center;
    gap: 15px;
}

.metrics strong {
    color: #9a8a7b;
    font: 600 1.2rem 'Manrope', sans-serif;
}

.metrics span {
    font-size: .85rem;
    color: #555b54;
}

/* Workspace cards */

.workspace-section {
    padding: 100px 8%;
    max-width: 1600px;
    margin: auto;
}

.section-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 35px;
    margin-bottom: 38px;
}

.section-heading h2 {
    margin: 12px 0 0;
    font-size: clamp(2.3rem, 4vw, 3.8rem);
    font-weight: 600;
}

.section-heading > p {
    max-width: 365px;
    color: var(--muted);
    font-size: .9rem;
    line-height: 1.8;
    margin-bottom: 5px;
}

.workspace-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
}

.feature-card {
    position: relative;
    min-height: 330px;
    padding: 27px;
    border-radius: 22px;
    overflow: hidden;
}

.feature-primary {
    background: #e9e0d6;
}

.feature-blue {
    background: #dcecf0;
}

.feature-light {
    background: #eeeee6;
}

.feature-icon {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 13px;
    background: #ffffffa8;
    font-size: 1.2rem;
}

.card-kicker {
    margin: 24px 0 12px;
    font-size: .65rem;
    letter-spacing: .12em;
    font-weight: 700;
    color: #77756c;
}

.feature-card h3 {
    margin-bottom: 13px;
    font-size: clamp(1.65rem, 2.5vw, 2.25rem);
    font-weight: 600;
}

.feature-card > p:not(.card-kicker) {
    max-width: 260px;
    color: #656a63;
    font-size: .82rem;
    line-height: 1.7;
}

.round-arrow {
    position: absolute;
    bottom: 24px;
    right: 24px;
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: #ffffffb8;
    font-size: 1.1rem;
}

.decorative-lines {
    position: absolute;
    bottom: -18px;
    right: 28px;
    display: flex;
    gap: 9px;
    align-items: end;
    opacity: .35;
}

.decorative-lines span {
    display: block;
    width: 13px;
    height: 95px;
    border: 1px solid var(--mocha);
    border-radius: 99px;
    transform: rotate(28deg);
}

.decorative-lines span:nth-child(2) {
    height: 130px;
}

.decorative-lines span:nth-child(3) {
    height: 75px;
}

.mini-clock {
    position: absolute;
    right: 24px;
    bottom: 35px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 82px;
    height: 82px;
    border: 1px solid #88a6ad;
    border-radius: 50%;
    color: #46666c;
}

.mini-clock span {
    font: 600 1.5rem 'Manrope', sans-serif;
}

.mini-clock small {
    font-size: .55rem;
    letter-spacing: .1em;
}

.growth-bars {
    position: absolute;
    bottom: 0;
    right: 20px;
    display: flex;
    align-items: end;
    gap: 6px;
    height: 88px;
    opacity: .55;
}

.growth-bars i {
    display: block;
    width: 12px;
    height: 25%;
    border-radius: 8px 8px 0 0;
    background: #a1a88c;
}

.growth-bars i:nth-child(2) { height: 45%; }
.growth-bars i:nth-child(3) { height: 35%; }
.growth-bars i:nth-child(4) { height: 65%; }
.growth-bars i:nth-child(5) { height: 53%; }
.growth-bars i:nth-child(6) { height: 80%; }
.growth-bars i:nth-child(7) { height: 100%; }

/* Inspiration section */

.quote-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 78px 20px 85px;
    background: var(--cream);
}

.quote-mark {
    height: 45px;
    color: #a18c7a;
    font: 5rem Georgia, serif;
    line-height: 1;
}

.quote-section blockquote {
    max-width: 750px;
    margin: 12px auto 18px;
    font: 500 clamp(1.8rem, 3.5vw, 3rem)/1.3 'Manrope', sans-serif;
    letter-spacing: -.045em;
}

.quote-section > p:not(.inspiration-message) {
    margin-bottom: 24px;
    color: var(--muted);
    font-size: .65rem;
    letter-spacing: .15em;
}

.button-outline {
    border: 1px solid #c7bdb1;
    background: transparent;
    color: var(--ink);
}

.inspiration-message {
    min-height: 25px;
    margin: 14px 0 0;
    color: var(--mocha);
    font-size: .85rem;
}

/* Footer */

.site-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    padding: 27px 6%;
}

.site-footer p,
.site-footer > span {
    margin: 0;
    color: var(--muted);
    font-size: .75rem;
}

/* Tablet */

@media (max-width: 900px) {
    .hero {
        gap: 28px;
        padding-top: 65px;
    }

    .hero-art {
        min-height: 380px;
    }

    .section-heading {
        align-items: start;
        flex-direction: column;
        gap: 12px;
    }

    .workspace-grid {
        grid-template-columns: 1fr 1fr;
    }

    .feature-card:last-child {
        grid-column: 1 / -1;
        min-height: 290px;
    }

    .feature-card h3 {
        font-size: 2rem;
    }
}

/* Mobile */

@media (max-width: 640px) {
    .site-header {
        min-height: 72px;
        position: relative;
    }

    .menu-toggle {
        display: block;
    }

    .nav-links {
        display: none;
        position: absolute;
        z-index: 10;
        top: 71px;
        left: 0;
        right: 0;
        padding: 18px 22px 24px;
        flex-direction: column;
        align-items: stretch;
        gap: 18px;
        background: var(--paper);
        border-bottom: 1px solid var(--line);
    }

    .nav-links.open {
        display: flex;
    }

    .nav-cta {
        text-align: center;
    }

    .hero {
        grid-template-columns: 1fr;
        padding: 55px 22px 45px;
    }

    .hero h1 {
        font-size: clamp(3.1rem, 14vw, 4.5rem);
    }

    .hero-art {
        min-height: 350px;
    }

    .art-card {
        padding: 20px;
    }

    .floating-note {
        right: 3%;
        bottom: 5%;
    }

    .metrics {
        grid-template-columns: 1fr;
        gap: 15px;
        padding: 25px 24px;
    }

    .metrics div {
        gap: 20px;
    }

    .workspace-section {
        padding: 68px 22px;
    }

    .workspace-grid {
        grid-template-columns: 1fr;
    }

    .feature-card,
    .feature-card:last-child {
        grid-column: auto;
        min-height: 310px;
    }

    .site-footer {
        flex-direction: column;
        text-align: center;
        padding: 28px 20px;
        gap: 12px;
    }
}

@media (prefers-reduced-motion: reduce) {
    html {
        scroll-behavior: auto;
    }

    *,
    *::before,
    *::after {
        transition-duration: .01ms !important;
    }
}